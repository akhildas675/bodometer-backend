{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "dist",

    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2020",
    "esModuleInterop": true,

    "baseUrl": "./src",
    "paths": {
      "@/*": ["*"]
    },

    "types": [],

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,

    "skipLibCheck": true
  }
}