{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:check": "eslint . --max-warnings 0",
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/server.ts",
    "seed:sections": "ts-node src/utils/onboarding.seed.ts",
    "dev:stripe": "stripe listen --forward-to localhost:5000/api/user/stripe/webhook",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:stripe\"",
    "build": "tsc && tsc-alias",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akhildas675/bodometer-backend.git"
  },
